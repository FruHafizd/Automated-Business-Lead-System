    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Terima kasih telah menghubungi kami \u2014 {{ $json.business }}",
        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">\n\n  <h2>\ud83d\udea8 Lead Request Received</h2>\n\n  <p>Halo <strong>{{ $json.name }}</strong>,</p>\n\n  <p>\n    Terima kasih telah menghubungi kami terkait kebutuhan\n    <strong>{{ $json.service }}</strong> untuk\n    <strong>{{ $json.business }}</strong>.\n  </p>\n\n  <p>Permintaan Anda sudah berhasil kami terima.</p>\n\n  <h3>Detail Permintaan</h3>\n\n  <table style=\"border-collapse: collapse;\">\n    <tr>\n      <td style=\"padding: 6px 15px 6px 0;\"><strong>Nama</strong></td>\n      <td style=\"padding: 6px;\">{{ $json.name }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 6px 15px 6px 0;\"><strong>Bisnis</strong></td>\n      <td style=\"padding: 6px;\">{{ $json.business }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 6px 15px 6px 0;\"><strong>Layanan</strong></td>\n      <td style=\"padding: 6px;\">{{ $json.service }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 6px 15px 6px 0;\"><strong>Estimasi Budget</strong></td>\n      <td style=\"padding: 6px;\">\n        Rp{{ Number($json.budget).toLocaleString('id-ID') }}\n      </td>\n    </tr>\n  </table>\n\n  <p>\n    Tim kami akan meninjau permintaan Anda dan menghubungi Anda\n    kembali untuk membahas kebutuhan lebih lanjut.\n  </p>\n\n  <p>Terima kasih telah menghubungi kami.</p>\n\n  <p>\n    Salam,<br>\n    <strong>Business Lead Team</strong>\n  </p>\n\n</body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
