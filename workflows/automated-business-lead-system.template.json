    {
      "parameters": {
        "jsCode": "const lead = $json;\n\nconst errors = [];\n\nif (!lead.name || String(lead.name).trim() === \"\") {\n  errors.push(\"name is required\");\n}\n\nif (!lead.email || String(lead.email).trim() === \"\") {\n  errors.push(\"email is required\");\n}\n\nif (!lead.business || String(lead.business).trim() === \"\") {\n  errors.push(\"business is required\");\n}\n\nif (!lead.service || String(lead.service).trim() === \"\") {\n  errors.push(\"service is required\");\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (lead.email && !emailRegex.test(String(lead.email).trim())) {\n  errors.push(\"invalid email format\");\n}\n\nconst phone = String(lead.phone || \"\").replace(/\\D/g, \"\");\n\nif (phone.length < 10 || phone.length > 15) {\n  errors.push(\"invalid phone number\");\n}\n\nconst budget = Number(lead.budget);\n\nif (!Number.isFinite(budget) || budget < 0) {\n  errors.push(\"invalid budget\");\n}\n\nreturn [\n  {\n    json: {\n      ...lead,\n      is_valid: errors.length === 0,\n      validation_errors: errors,\n      status: errors.length === 0 ? \"NEW\" : \"INVALID\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        768
      ],
      "id": "3ca3be13-70ce-408b-a562-fe8f46fc9bf9",
      "name": "Validate Lead"
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\n\nlet score = 0;\nconst scoring_reasons = [];\n\n// =========================\n// BUDGET SCORE\n// =========================\n\nconst budget = Number(lead.budget);\n\nif (budget >= 10000000) {\n  score += 40;\n  scoring_reasons.push(\"High budget\");\n} else if (budget >= 5000000) {\n  score += 30;\n  scoring_reasons.push(\"Medium-high budget\");\n} else if (budget >= 2000000) {\n  score += 20;\n  scoring_reasons.push(\"Medium budget\");\n} else if (budget >= 1000000) {\n  score += 10;\n  scoring_reasons.push(\"Low-medium budget\");\n}\n\n// =========================\n// SERVICE SCORE\n// =========================\n\nconst service = String(lead.service || \"\").toLowerCase();\n\nconst highValueServices = [\n  \"website\",\n  \"web development\",\n  \"web app\",\n  \"application\",\n  \"mobile app\",\n  \"ecommerce\"\n];\n\nif (highValueServices.some(item => service.includes(item))) {\n  score += 20;\n  scoring_reasons.push(\"High-value service\");\n} else if (service) {\n  score += 10;\n  scoring_reasons.push(\"Service provided\");\n}\n\n// =========================\n// BUSINESS INFORMATION\n// =========================\n\nif (lead.business && String(lead.business).trim().length >= 3) {\n  score += 15;\n  scoring_reasons.push(\"Business information provided\");\n}\n\n// =========================\n// CONTACT INFORMATION\n// =========================\n\nif (lead.email) {\n  score += 10;\n  scoring_reasons.push(\"Email provided\");\n}\n\nif (lead.phone) {\n  score += 5;\n  scoring_reasons.push(\"Phone provided\");\n}\n\n// =========================\n// LEAD CLASSIFICATION\n// =========================\n\nlet priority;\n\nif (score >= 70) {\n  priority = \"HIGH\";\n} else if (score >= 40) {\n  priority = \"MEDIUM\";\n} else {\n  priority = \"LOW\";\n}\n\nreturn [\n  {\n    json: {\n      ...lead,\n      score,\n      priority,\n      scoring_reasons\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        768
      ],
      "id": "d5d0b12a-a578-4e4d-af3e-c6c7229aace2",
      "name": "Lead Scoring"
    },
    {
      "parameters": {
