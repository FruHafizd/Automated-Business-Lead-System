        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=\ud83d\udea8 NEW BUSINESS LEAD\n\n\ud83d\udc64 {{ $json.name }}\n\ud83c\udfe2 {{ $json.business }}\n\n\ud83d\udce7 {{ $json.email }}\n\ud83d\udcf1 {{ $json.phone }}\n\n\ud83d\udcbc {{ $json.service }}\n\ud83d\udcb0 Rp{{ Number($json.budget).toLocaleString('id-ID') }}\n\n\ud83d\udcca Score: {{ $json.score }}/100\n\ud83d\udd25 Priority: {{ $json.priority }}\n\n\ud83d\udccc {{ $json.status }}\n\ud83d\udd50 {{ new Date($json.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) }}",
